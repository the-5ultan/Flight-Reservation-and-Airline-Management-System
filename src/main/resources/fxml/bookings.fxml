<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.aeroreserve.controller.BookingController">
    <content>
        <VBox spacing="18">
            <padding><Insets bottom="30" left="30" right="30" top="26" /></padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="4">
                            <children>
                                <Label fx:id="pageTitle" styleClass="page-title" text="Bookings" />
                                <Label styleClass="page-subtitle" text="Review reservations, tickets and cancellation status" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshButton" text="↻  Refresh" styleClass="btn-secondary, btn-small"
                                onAction="#handleRefresh" />
                    </children>
                </HBox>

                <VBox styleClass="glass-card" spacing="12">
                    <padding><Insets top="16" right="18" bottom="16" left="18" /></padding>
                    <children>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="field-label" text="STATUS" />
                                <ComboBox fx:id="statusFilter" />
                                <Label fx:id="searchLabel" styleClass="field-label" text="SEARCH" />
                                <TextField fx:id="searchField" promptText="Reference, flight or passenger"
                                           styleClass="glass-input" prefWidth="260" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="summaryLabel" styleClass="muted-text" text="" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox styleClass="glass-card" spacing="12" VBox.vgrow="ALWAYS">
                    <padding><Insets top="18" right="18" bottom="18" left="18" /></padding>
                    <children>
                        <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS" prefHeight="390">
                            <columns>
                                <TableColumn fx:id="colRef" text="REFERENCE" minWidth="120" />
                                <TableColumn fx:id="colPassenger" text="PASSENGER" minWidth="150" />
                                <TableColumn fx:id="colFlight" text="FLIGHT" minWidth="90" />
                                <TableColumn fx:id="colRoute" text="ROUTE" minWidth="120" />
                                <TableColumn fx:id="colSeats" text="SEATS" minWidth="110" />
                                <TableColumn fx:id="colClass" text="CABIN" minWidth="100" />
                                <TableColumn fx:id="colDate" text="BOOKED" minWidth="140" />
                                <TableColumn fx:id="colAmount" text="TOTAL" minWidth="100" />
                                <TableColumn fx:id="colStatus" text="STATUS" minWidth="110" />
                                <TableColumn fx:id="colActions" text="ACTIONS" minWidth="190" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox fx:id="previewPane" styleClass="glass-card" spacing="12" visible="false" managed="false">
                    <padding><Insets top="18" right="18" bottom="18" left="18" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="previewTitle" styleClass="section-title" text="Ticket preview" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="Export ticket" styleClass="btn-secondary, btn-small"
                                        onAction="#handleExport" />
                                <Button text="Print" styleClass="btn-ghost, btn-small" onAction="#handlePrint" />
                                <Button text="Close" styleClass="btn-ghost, btn-small" onAction="#handleClosePreview" />
                            </children>
                        </HBox>
                        <TextArea fx:id="ticketPreview" editable="false" wrapText="true"
                                  prefHeight="330" styleClass="ticket-preview" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
