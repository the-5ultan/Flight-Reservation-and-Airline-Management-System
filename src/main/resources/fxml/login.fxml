<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.aeroreserve.controller.LoginController"
           stylesheets="@../css/theme.css" styleClass="login-root">

    <children>
        <VBox alignment="CENTER" spacing="0">
            <children>
                <VBox fx:id="loginCard" alignment="CENTER" spacing="18" maxWidth="430"
                      styleClass="glass-card, login-card">
                    <padding>
                        <Insets bottom="38" left="42" right="42" top="38" />
                    </padding>
                    <children>
                        <StackPane alignment="CENTER" prefHeight="58">
                            <children>
                                <Pane styleClass="brand-mark" />
                                <Text styleClass="brand-glyph" text="✈" />
                            </children>
                        </StackPane>

                        <VBox alignment="CENTER" spacing="4">
                            <children>
                                <Label styleClass="login-title" text="AeroReserve" />
                                <Label styleClass="login-subtitle"
                                       text="Flight Reservation &amp; Airline Management" />
                            </children>
                        </VBox>

                        <VBox spacing="14">
                            <children>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="EMAIL ADDRESS" />
                                        <TextField fx:id="emailField" promptText="name@example.com"
                                                   styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="PASSWORD" />
                                        <PasswordField fx:id="passwordField" promptText="Enter your password"
                                                       styleClass="glass-input" onAction="#handleLogin" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <CheckBox fx:id="showPasswordBox" styleClass="glass-check"
                                          text="Show password" onAction="#handleShowPassword" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Hyperlink styleClass="glass-link" text="Forgot password?"
                                           onAction="#handleForgotPassword" />
                            </children>
                        </HBox>

                        <Label fx:id="messageLabel" styleClass="form-message" wrapText="true"
                               managed="false" />

                        <Button fx:id="loginButton" text="Sign in" prefWidth="345"
                                styleClass="btn-primary, btn-large" onAction="#handleLogin" />

                        <HBox alignment="CENTER" spacing="6">
                            <children>
                                <Label styleClass="login-hint" text="New to AeroReserve?" />
                                <Hyperlink fx:id="registerLink" styleClass="glass-link"
                                           text="Create an account" onAction="#handleRegisterToggle" />
                            </children>
                        </HBox>

                        <VBox fx:id="registerBox" spacing="12" managed="false" visible="false">
                            <children>
                                <Region prefHeight="1" styleClass="divider" />
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="FULL NAME" />
                                        <TextField fx:id="nameField" promptText="e.g. Ada Lovelace"
                                                   styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="PHONE NUMBER" />
                                        <TextField fx:id="phoneField" promptText="e.g. +1 555 0100"
                                                   styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="NATIONALITY" />
                                        <TextField fx:id="nationalityField" promptText="e.g. British"
                                                   styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="PASSPORT NUMBER (OPTIONAL)" />
                                        <TextField fx:id="passportField" promptText="e.g. X1234567"
                                                   styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <VBox spacing="6">
                                    <children>
                                        <Label styleClass="field-label" text="CONFIRM PASSWORD" />
                                        <PasswordField fx:id="confirmField" promptText="Repeat your password"
                                                       styleClass="glass-input" />
                                    </children>
                                </VBox>
                                <Button fx:id="registerButton" text="Create passenger account"
                                        prefWidth="345" styleClass="btn-secondary, btn-large"
                                        onAction="#handleRegister" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>

        <VBox alignment="BOTTOM_CENTER" mouseTransparent="true">
            <padding>
                <Insets bottom="18" />
            </padding>
            <children>
                <Label styleClass="login-footer"
                       text="AeroReserve  •  Academic Java OOP Project  •  Serialized local data" />
            </children>
        </VBox>
    </children>
</StackPane>
